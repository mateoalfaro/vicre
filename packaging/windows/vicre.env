# Vicre settings: edit and save; applies on the next capture (no rebuild, no restart).
# Lines starting with # are ignored. A real environment variable of the same name wins.

# Model and variant passed to OpenCode as "model#variant".
VICRE_MODEL=opencode-go/glm-5.3-flash
VICRE_VARIANT=max
# Leave VICRE_VARIANT empty (VICRE_VARIANT=) to send no variant.

# Seconds to wait before pasting (lets you release ctrl+alt).
#VICRE_PASTE_DELAY=0.35

# Path to the OpenCode executable if it is not next to vicre.exe or on PATH.
#VICRE_OPENCODE_BIN=D:\tools\opencode2.exe
